{
	"name": "scribe-frontend",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
		"build": "vite build --mode production",
		"build:desktop": "./build-desktop.sh",
		"build:typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
		"preview": "vite preview",
