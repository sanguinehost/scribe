{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe Desktop",
  "version": "0.1.0",
  "identifier": "com.sanguine.scribe",
  "build": {
    "frontendDist": "../frontend/build",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Scribe",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "scribe://localhost"
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "scribe:", "tauri:"],
        "connect-src": ["'self'", "scribe:", "tauri:", "ipc:", "ws:", "wss:"],
        "script-src": ["'self'", "'unsafe-inline'", "'unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:", "asset:"],
        "font-src": ["'self'", "data:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scribe-backend"
    ]
  }
}
