{
    "name": "credit_anomaly",
    "description": "Detects unusual credit consumption patterns",
    "stream_type": "logs",
    "stream_name": "default",
    "enabled": true,
    "query_condition": {
        "type": "sql",
        "sql": "SELECT count(*) as count, min(trace_id) as trace_ref FROM default WHERE service_name IN ('scribe-backend', 'scribe_backend') AND event_type = 'credit_operation_anomaly' HAVING count > 0"
    },
    "row_template": "- {count} anomalies detected! (Sample Trace: {trace_ref})",
    "trigger_condition": {
        "period": 15,
        "operator": ">",
        "threshold": 0,
        "frequency": 1,
        "frequency_type": "minutes",
        "silence": 120,
        "timezone": "UTC"
    },
    "destinations": [
        "discord_dest"
    ]
}
