{
    "name": "auth_polling",
    "description": "Detects abnormal polling frequency for /auth/me",
    "stream_type": "logs",
    "stream_name": "default",
    "enabled": true,
    "query_condition": {
        "type": "sql",
        "sql": "SELECT count(*) as count, user_id, min(trace_id) as trace_ref FROM default WHERE service_name IN ('scribe-backend', 'scribe_backend') AND path = '/api/auth/me' GROUP BY user_id HAVING count > 100"
    },
    "row_template": "- User {user_id}: {count} polling requests (Sample Trace: {trace_ref})",
    "trigger_condition": {
        "period": 5,
        "operator": ">",
        "threshold": 0,
        "frequency": 1,
        "frequency_type": "minutes",
        "silence": 60,
        "timezone": "UTC"
    },
    "destinations": [
        "discord_dest"
    ]
}
