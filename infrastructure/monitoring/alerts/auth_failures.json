{
    "name": "auth_failures",
    "description": "Detects high-volume authentication failures",
    "stream_type": "logs",
    "stream_name": "default",
    "enabled": true,
    "query_condition": {
        "type": "sql",
        "sql": "SELECT count(*) as total, client_ip, min(trace_id) as trace_ref FROM default WHERE service_name IN ('scribe-backend', 'scribe_backend') AND event_type = 'auth_failure' GROUP BY client_ip HAVING count(*) > 10"
    },
    "row_template": "- IP {client_ip}: {total} failures (Sample Trace: {trace_ref})",
    "trigger_condition": {
        "period": 5,
        "operator": ">",
        "threshold": 0,
        "frequency": 1,
        "frequency_type": "minutes",
        "silence": 5,
        "timezone": "UTC"
    },
    "destinations": [
        "discord_dest"
    ]
}
